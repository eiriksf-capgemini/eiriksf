{
  "ci": {
    "collect": {
      "staticDistDir": "./out",
      "url": [
        "/index.html",
        "/cv/index.html",
        "/ki/index.html",
        "/innlegg/index.html",
        "/innlegg/idp-fra-dager-til-minutter/index.html"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
